    "AI 回答由 %@ 生成。Ginkgo 会用你自己的 key，把选中的原文、它前后的几段文字、书名和你的问题直接发给 %@。Ginkgo 没有自己的服务器，看不到也不保存这些内容；%@ 按它的隐私政策处理。可以随时在设置里关掉。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AI answers are written by %1$@. Using your own key, Ginkgo sends the passage you selected, the paragraphs around it, the book title and your question directly to %2$@. Ginkgo has no server of its own and never sees or stores any of it; %3$@ handles it under its privacy policy. You can turn this off at any time in Settings."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 回答由 %@ 生成。Ginkgo 会用你自己的 key，把选中的原文、它前后的几段文字、书名和你的问题直接发给 %@。Ginkgo 没有自己的服务器，看不到也不保存这些内容；%@ 按它的隐私政策处理。可以随时在设置里关掉。"
          }
        }
      }
    },
    "AI 批注": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AI notes"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "AI 批注"
          }
        }
      }
    },
